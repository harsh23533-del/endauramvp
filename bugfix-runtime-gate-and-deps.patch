From 3321ca759b27e52a86f7cef10a6ddd348eb2883c Mon Sep 17 00:00:00 2001
From: AURA <aura@local>
Date: Sun, 23 Aug 2026 21:32:21 +0000
Subject: [PATCH] Fix 2 more live bugs: (1) release_gate never checked
 runtime_result at all, so an app that fails to start could still reach
 RELEASE_READY -- now blocks release on a confirmed runtime start failure; (2)
 Runtime Agent's health-check command ran python app.py in a fresh empty
 sandbox container without installing requirements.txt first, so it always
 failed for Flask apps regardless of code correctness -- now installs deps
 before starting the app, same pattern test_runner.py already used

---
 core/orchestrator.py  |  1 +
 core/release_gate.py  | 10 ++++++++++
 core/runtime_agent.py | 11 +++++++++++
 3 files changed, 22 insertions(+)

diff --git a/core/orchestrator.py b/core/orchestrator.py
index 094a252..f6d11e6 100644
--- a/core/orchestrator.py
+++ b/core/orchestrator.py
@@ -384,6 +384,7 @@ def build(user_request: str, require_approval: bool = False) -> dict:
         print(f"Infra issue   : {infra_error} (fix your environment, then re-run)")
     print(f"Debug attempts: {debug_attempts} ({patches_rejected} rejected as regressions)")
     print(f"Security      : {'PASS' if security_result['passed'] and dependency_result['passed'] else 'HIGH-SEVERITY ISSUES'}")
+    print(f"Runtime       : {'STARTED' if runtime_result.get('started') else ('FAILED TO START' if runtime_result.get('started') is False else 'not checked')}")
     print(f"Review        : {'APPROVED' if review_result.get('approved') else 'CHANGES REQUESTED'}")
     print(f"Critic        : {critic_result.get('verdict', 'unknown')}")
     print(f"Release Gate  : {gate['status']}")
diff --git a/core/release_gate.py b/core/release_gate.py
index eb29d09..6262613 100644
--- a/core/release_gate.py
+++ b/core/release_gate.py
@@ -37,6 +37,16 @@ def evaluate_release(report: dict) -> dict:
     if critic_result.get("verdict") == "breaks_easily":
         reasons.append("Critic found the implementation breaks easily.")
 
+    # This was missing entirely -- runtime_result was computed and logged
+    # (section 13's Runtime Agent) but never actually fed into the gate,
+    # so an app that fails to even start could still reach RELEASE_READY
+    # as long as its unit tests happened to pass. started is False for a
+    # confirmed failure to start; None means the check was inconclusive
+    # (e.g. not a Flask app) and shouldn't block on its own.
+    runtime_result = report.get("runtime_result", {})
+    if runtime_result.get("started") is False:
+        reasons.append(f"App failed to start at runtime: {runtime_result.get('detail', '(no detail)')}")
+
     infra_error = report.get("infra_error")
     if infra_error:
         reasons.append(f"Infrastructure issue: {infra_error}")
diff --git a/core/runtime_agent.py b/core/runtime_agent.py
index c0f99e7..55d631f 100644
--- a/core/runtime_agent.py
+++ b/core/runtime_agent.py
@@ -5,6 +5,14 @@ up without crashing -- a signal distinct from unit tests, which can
 pass even if the app itself fails to boot (missing import at module
 level, port binding issue, etc). PDF section 13, scaled down: no
 Docker Compose / multi-service orchestration, just "does it start."
+
+Bug fixed after a live functional test: run_in_sandbox() launches a
+FRESH, empty Docker container every call (same reason
+tools/test_runner.py installs deps inside its own command instead of
+relying on a previous install persisting) -- so the health-check
+command must install requirements.txt itself before running app.py,
+or Flask (etc.) simply isn't there and the app always "fails to
+start" for a reason that has nothing to do with the generated code.
 """
 from tools.sandbox import run_in_sandbox
 
@@ -13,6 +21,9 @@ from tools.sandbox import run_in_sandbox
 # server and the curl call share localhost.
 _HEALTH_CHECK_CMD = (
     "if [ -f app.py ]; then "
+    "  if [ -f requirements.txt ]; then "
+    "    pip install --quiet --disable-pip-version-check -r requirements.txt ; "
+    "  fi ; "
     "  (python app.py > /tmp/aura_runtime.log 2>&1 &) ; "
     "  sleep 2 ; "
     "  RESULT=$(curl -s -o /dev/null -w '%{http_code}' http://localhost:5000/ --max-time 3 || echo 'NO_RESPONSE') ; "
-- 
2.43.0

