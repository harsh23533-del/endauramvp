# Required to run AURA at all (CLI or server) with the host's own quota.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# --- Web server (server.py) only, all optional ---

# Shared secret required in the X-Access-Code header for every /api/*
# call. If unset, a random one is printed to the server's logs on
# startup (won't survive a restart) -- set this explicitly for anything
# you actually deploy.
ACCESS_CODE=choose-a-secret-access-code

# Per-IP build cap, so one visitor can't burn the whole OPENROUTER_API_KEY
# quota. Doesn't apply to callers who supply their own API key in the
# build request (see README: "Bring your own API key").
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=3600

# Force the non-Docker subprocess sandbox even when a Docker daemon is
# reachable -- useful for testing the hosted code path locally. Hosted
# PaaS platforms without Docker access (Render, Railway, etc.) fall back
# to this automatically; you don't need to set it there.
AURA_FORCE_SUBPROCESS_SANDBOX=0

# Wall-clock budget (seconds) for a SINGLE LLM call, across every model
# in the fallback chain and every retry combined. Without this, a call
# can block for the theoretical worst case of ~6 models x 3 attempts x
# 30s timeout (~9-10 minutes) if the free-tier quota is exhausted --
# which is what "stuck on Coder" almost always is, since Coder makes
# the most LLM calls of any stage. Lower it for snappier failure on a
# busy shared deployment; raise it if your own key has more headroom.
AURA_LLM_CALL_BUDGET_SECONDS=60

# --- Optional model overrides ---
# Force one model for every call, bypassing the role router and fallback
# chain entirely.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Or override individual roles (see core/llm.py ROLE_DEFAULTS):
# OPENROUTER_MODEL_REASONING=
# OPENROUTER_MODEL_CODING=
# OPENROUTER_MODEL_FAST=
